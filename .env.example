# Padellen Court Monitoring System Configuration

# Apprise notification URLs (comma-separated for multiple services)
#
# NTFY.SH (RECOMMENDED - Simple push notifications, no auth needed)
#   Format: ntfy://ntfy.sh/your-unique-topic
#   Example: ntfy://ntfy.sh/padellen-monitor
#   Note: The topic name appears in the URL, choose something unique
#   Subscribe to notifications at: https://ntfy.sh/padellen-monitor
#
# NTFY Self-Hosted (without auth)
#   Format: ntfy://your-domain.com/your-topic
#   Example: ntfy://ntfy.example.com/padellen
#   HTTPS: ntfys://ntfy.example.com/padellen
#
# NTFY Self-Hosted (with token authentication)
#   Format: ntfys://token@your-domain.com/your-topic
#   Example: ntfys://mytoken123@ntfy.example.com/padellen
#   Note: Replace 'mytoken123' with your actual token
#
# NTFY Self-Hosted (with user/password authentication)
#   Format: ntfys://user:password@your-domain.com/your-topic
#   Example: ntfys://myuser:mypassword@ntfy.example.com/padellen
#   Note: Use ntfys:// (HTTPS) when using credentials
#
# TELEGRAM
#   Format: tgram://bot-token/chat-id
#   Example: tgram://123456789:ABCDefGHIjklmnoPQRstuvwxyz/987654321
#   How to get: Create bot with @BotFather, get chat ID with @userinfobot
#
# DISCORD
#   Format: discord://webhook-id/webhook-token
#   Example: discord://123456789/abcdefghijklmnop
#   How to get: Create webhook in Discord server settings
#
# Multiple services (comma-separated):
#   APPRISE_URLS=ntfy://ntfy.sh/padellen-monitor,tgram://token/chatid,discord://id/token

APPRISE_URLS=ntfy://ntfy.sh/padellen-monitor

# Target date in ISO format (YYYY-MM-DD)
TARGET_DATE=2026-02-10

# Time range for available slots (24-hour format HH:MM)
TIME_RANGE_START=18:00
TIME_RANGE_END=22:00

# Location ID (optional, default: bookings-locations-15-name for The Padellers)
# Find the location ID by inspecting the location element on the Padellen website
# LOCATION_ID=bookings-locations-15-name

# Booking duration in minutes (optional, default: 60)
# Options: 60, 90, or 120
# DURATION_MINUTES=60

# Priority times - preferred booking times in order (optional, comma-separated)
# Example: 16:00,15:00,17:00
# PRIORITY_TIMES=18:00,19:00,20:00

# Poll interval in seconds (optional, defaults shown)
MIN_POLL_INTERVAL=600
MAX_POLL_INTERVAL=1200

# Retry configuration (optional, defaults shown)
MAX_RETRIES=3
RETRY_BACKOFF=2

# Wait timeout for page elements in seconds (optional, default: 10)
# Increase if you have slow network or slow page loading
# WAIT_TIMEOUT=10

# Chrome executable path (optional, usually not needed)
# Only set this if Chrome is installed in a non-standard location on your machine
# NOT needed for Docker (Chromium is built-in)
# Example: C:\Chrome\chrome.exe or /opt/chrome/chrome
# CHROME_PATH=

# Run Chrome in headless mode (optional, default: true)
# Set to "false" to see the Chrome window while running
# HEADLESS=true

# Auto-booking configuration (optional)
# When enabled, the bot will automatically book the best available slot
# and keep the reservation alive by renewing every ~4m50s
# AUTO_BOOK=false

# Padellen account credentials (required when AUTO_BOOK=true)
# BOOKING_EMAIL=your-email@example.com
# BOOKING_PASSWORD=your-password
